{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch backend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/server.js",
      "runtimeArgs": ["--enable-source-maps"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal"
    }
  ]
}